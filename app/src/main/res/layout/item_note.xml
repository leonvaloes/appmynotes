<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/list_item_background" android:minHeight="88dp" android:orientation="horizontal">
    <View android:id="@+id/priority_color" android:layout_width="7dp" android:layout_height="match_parent" android:background="@color/primary" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/note_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/note_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/note_priority" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAllCaps="true" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
